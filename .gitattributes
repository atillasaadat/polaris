# Polaris is Linux-first and cross-platform (WSL/Linux + macOS). Normalize all
# text to LF in the repository and on checkout, regardless of a contributor's
# core.autocrlf setting, so shell scripts and C++/Python sources stay LF.
* text=auto eol=lf

# Scripts must be LF (CRLF breaks the shebang/interpreter).
*.sh text eol=lf

# Common binary types (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.bsp  binary
*.bpc  binary
