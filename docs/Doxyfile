# Doxygen config for Polaris C++ API extraction -> XML -> Breathe -> Sphinx.
# Run from docs/:  doxygen Doxyfile   (build_docs.sh does this automatically).
# Produces docs/doxygen/xml consumed by Breathe (see conf.py breathe_projects).

PROJECT_NAME           = "Polaris"
PROJECT_BRIEF          = "Spacecraft GNC flight software & simulation"
OUTPUT_DIRECTORY       = doxygen

# lib/ (shared library) and sim/ (truth simulation) are documented here.
# flight/ is deliberately excluded: Doxygen would pull in the F´-autocoded
# *Ac.hpp/*Ac.cpp next to the hand-written components and bury them in framework
# noise. Adding it would also need EXCLUDE_PATTERNS fixed first — the `*/build/*`
# pattern below does not match this repo's build directories, which fprime-util
# names build-fprime-automatic-native* (see .gitignore).
INPUT                  = ../lib ../sim
FILE_PATTERNS          = *.h *.hpp *.hh *.hxx *.cpp *.cc *.cxx
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */fprime/* */build/* */_build/*

# Output: XML only (Breathe consumes it); no HTML/LaTeX from Doxygen itself.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES

# Keep the docs build quiet: the Sphinx `-W` gate is what enforces documentation
# quality, so Doxygen itself only needs to produce the XML, not police it.
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
