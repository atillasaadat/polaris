# Doxygen config for Polaris C++ API extraction -> XML -> Breathe -> Sphinx.
# Run from docs/:  doxygen Doxyfile   (build_docs.sh does this automatically).
# Produces docs/doxygen/xml consumed by Breathe (see conf.py breathe_projects).

PROJECT_NAME           = "Polaris"
PROJECT_BRIEF          = "Spacecraft GNC flight software & simulation"
OUTPUT_DIRECTORY       = doxygen

# Scoped to lib/ for now — the shared Polaris C++ library is what the API page
# documents. flight/ and sim/ are added here once they carry documented,
# non-F´-generated code; parsing the F´ topology now only adds framework noise.
INPUT                  = ../lib ../sim
FILE_PATTERNS          = *.h *.hpp *.hh *.hxx *.cpp *.cc *.cxx
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */fprime/* */build/* */_build/*

# Output: XML only (Breathe consumes it); no HTML/LaTeX from Doxygen itself.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES

# Keep the docs build quiet and non-fatal on the (currently empty) input.
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
