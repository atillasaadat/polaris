# ── Build (C++/CMake/F´) ───────────────────────────────────────────────
build/
build-fprime-automatic-native*/
build-artifacts/
cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
compile_commands.json
CMakeCache.txt
CMakeFiles/

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Virtual environments ───────────────────────────────────────────────
*-venv/
.venv/
venv/
fprime-venv/
docs-venv/

# ── Documentation build ────────────────────────────────────────────────
docs/_build/
docs/doxygen/
docs/_generated/*.json

# ── Tooling / external installs (not vendored) ─────────────────────────
tools/gmat/GMAT/
tools/gmat/*.tar.gz
*.log

# F´ data-product catalog: written at runtime by the deployment's DpCatalog
# component into the working directory.
/DpCat/

# ── Editor / OS ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store

# Keep generated-dir placeholders tracked
!docs/_generated/.gitkeep

# ── Claude Code / ruflo tooling ────────────────────────────────────────
# Tracked: .mcp.json, CLAUDE.md, .claude/settings.json, and the Polaris-specific
# subagents/slash commands under .claude/agents/ and .claude/commands/ — those are
# force-added (`git add -f`) and override the directory patterns below, which exist
# to keep the *vendored* ruflo assets out; those regenerate via `npx ruflo init`.
# Runtime state and local overrides are never tracked.
.claude-flow/
.claude/agents/
.claude/commands/
.claude/helpers/
.claude/skills/
.claude/settings.local.json
.claude/proven-config.json
.claude/.proven-config-version
CLAUDE.md.pre-ruflo
*local-command-caveat*.txt
# Claude Code conversation exports (/export): date-prefixed .txt dumps at root.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Full EGM2008 model (fetch input for tools/gravity; only the degree-truncated
# tests/golden/EGM2008_to200.gfc is committed)
/EGM2008.gfc

# JPL DE440 SPK kernels (fetch input for tools/ephem; only the derived Chebyshev
# fit tests/golden/de440_sun_moon.cheb is committed — design doc §3.7)
/de440*.bsp

# Vendor sensor/actuator datasheets (reference inputs for the config/hardware
# catalog; the specs are transcribed into the *.yaml entries, the PDFs are not
# committed).
/*-datasheet-*.pdf

# FreeFlyer local install (installer, license key, vendor help docs) — never committed
/freeflyer/
