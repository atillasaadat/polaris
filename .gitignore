# ── Build (C++/CMake/F´) ───────────────────────────────────────────────
build/
build-fprime-automatic-native*/
build-artifacts/
cmake-build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
compile_commands.json
CMakeCache.txt
CMakeFiles/

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Virtual environments ───────────────────────────────────────────────
*-venv/
.venv/
venv/
fprime-venv/
docs-venv/

# ── Documentation build ────────────────────────────────────────────────
docs/_build/
docs/doxygen/
docs/_generated/*.json

# ── Tooling / external installs (not vendored) ─────────────────────────
tools/gmat/GMAT/
tools/gmat/*.tar.gz
*.log

# ── Editor / OS ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store

# Keep generated-dir placeholders tracked
!docs/_generated/.gitkeep

# ── Claude Code / ruflo tooling ────────────────────────────────────────
# Tracked (the glue that enables ruflo for the repo): .mcp.json, CLAUDE.md,
# .claude/settings.json. The vendored agent/command/skill assets under .claude/
# are regenerable via `npx ruflo init`, so they are intentionally NOT tracked.
# Runtime state and local overrides are never tracked.
.claude-flow/
.claude/agents/
.claude/commands/
.claude/helpers/
.claude/skills/
.claude/settings.local.json
.claude/proven-config.json
.claude/.proven-config-version
CLAUDE.md.pre-ruflo
*local-command-caveat*.txt
# Claude Code conversation exports (/export): date-prefixed .txt dumps at root.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
