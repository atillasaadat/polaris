root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{fpp,fppi}]
indent_size = 2

[*.{rst,md}]
indent_size = 2
trim_trailing_whitespace = false  # trailing spaces can be meaningful in RST/MD

[Makefile]
indent_style = tab
